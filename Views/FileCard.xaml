<UserControl x:Class="FileDock.Views.FileCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="80"
             Height="80"
             MouseDoubleClick="OnMouseDoubleClick">
    <Border x:Name="CardBorder"
            Background="{StaticResource SurfaceCardBrush}"
            BorderBrush="{StaticResource HairlineBrush}"
            BorderThickness="1"
            CornerRadius="8"
            SnapsToDevicePixels="True">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="打开" Click="OpenMenuItem_Click" />
                <MenuItem Header="打开所在位置" Click="OpenLocationMenuItem_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid Margin="8">
            <Image Width="40"
                   Height="40"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,5,0,0"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="{Binding Entry.Icon, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <TextBlock Margin="0,50,0,0"
                       Width="58"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       FontSize="11"
                       Foreground="{StaticResource BodyBrush}"
                       Text="{Binding Entry.DisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
            <Button x:Name="CopyButton"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource CanvasBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="1"
                    Click="CopyButton_Click"
                    Cursor="Hand"
                    FontSize="11"
                    Foreground="{StaticResource MutedBrush}"
                    Padding="0"
                    ToolTip="复制">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="⧉" />
            </Button>
        </Grid>
    </Border>
</UserControl>
